# Copy this file to .env.local and fill in your own values. Use the SAME
# Supabase project as carcoolie-admin's .env.local so both apps read/write
# the same data — see supabase-schema.sql (repo root) for the schema this
# app expects once Supabase is configured.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps JavaScript API key, used by the "Select on Map" picker on the
# booking page (app/services/b2c/book). Needs the Maps JavaScript API and
# Geocoding API enabled, and should be restricted to your site's domain(s)
# in the Google Cloud Console. Without this set, that picker falls back to
# the free, keyless Leaflet/OpenStreetMap map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
